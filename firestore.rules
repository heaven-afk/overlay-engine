rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Access functions ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == 'ogadizion01@gmail.com';
    }

    // ─── Overlay Engine collections ────────────────────────────────────
    // Public reads preserved (required for OBS Browser Source to render
    // without logging in). Writes allowed for ANY signed-in Firebase user —
    // access is controlled by who has a Firebase Auth account at all
    // (created manually by the owner in the Firebase Console).
    match /overlayTemplates/{templateId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /overlaySlots/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /pushHistory/{historyId} {
        allow read, write: if isSignedIn();
      }
      match /scheduledPushes/{pushId} {
        allow read, write: if isSignedIn();
      }
      match /editLog/{logId} {
        allow read, write: if isSignedIn();
      }
    }

    match /overlayTeams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /overlayInvites/{inviteId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /overlayDataFieldCatalog/{catalogId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── Studio Room ───────────────────────────────────────────────────
    // Isolated block — no cross-references to Heaven Stat Engine rules.
    // Uses isSignedIn() consistent with the rest of the Overlay Engine
    // collections (Firebase Auth account creation is manually controlled).
    match /studioProjects/{projectId} {
      allow read: if true;   // public: OBS Browser Source reads project by token/ID without auth
      allow write: if isSignedIn();

      match /playlists/{playlistId} {
        allow read, write: if isSignedIn();

        match /items/{itemId} {
          allow read, write: if isSignedIn();
        }
      }

      match /live/{liveDoc} {
        allow read: if true;   // public: OBS Browser Source reads without auth
        allow write: if isSignedIn();
      }

      match /pushHistory/{historyId} {
        allow read, write: if isSignedIn();
      }
    }

    // ─── Heaven Stat Engine data ───────────────────────────────────────
    // Public reads preserved (Overlay Engine public render page and OBS
    // need to read team names/logos/tournament data without logging in).
    // Writes allowed for any signed-in Firebase user.
    match /tournaments/{tournamentId}/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /clans/{clanId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ─── Fallback rule for any other collection ───────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}

